<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModel="clr-namespace:Music2Web.Content"
             x:Class="Music2Web.Content.Music2WebView"
             x:DataType="viewModel:IMusic2WebViewModel">

    <Grid>
        <!-- Actual WebView -->
        <WebView x:Name="InnerWebView"
                 UserAgent="{Binding WebData.UserAgent.Value}"
                 Source="{Binding WebData.Address.Value}"
                 Navigating="OnWebViewNavigating"
                 Navigated="OnWebViewNavigated" />

        <!-- Dim overlay when loading -->
        <BoxView Color="#B0000000"
                 IsVisible="{Binding IsLoading}" />

        <!-- Centered spinner with caption -->
        <StackLayout IsVisible="{Binding IsLoading}"
                     HorizontalOptions="Center"
                     VerticalOptions="Center"
                     Spacing="8"
                     Padding="0">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               Color="#E00000" />
            <Label Text="Laden..."
                   HorizontalOptions="Center"
                   TextColor="#E00000"
                   FontSize="Small" />
        </StackLayout>
    </Grid>
</ContentView>